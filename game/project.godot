; 风铃谷 — Godot 4 工程配置
; 打开方式：Godot 4.2+ → 导入 → 选择本目录 project.godot

config_version=5

[application]

config/name="风铃谷"
config/description="单机休闲田园生活游戏 — 灰盒可玩版本"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
UiTheme="*res://scripts/autoload/ui_theme.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Bgm="*res://scripts/autoload/bgm.gd"
QuestLog="*res://scripts/autoload/quest_log.gd"
HeartDb="*res://scripts/autoload/heart_db.gd"
MarketDb="*res://scripts/autoload/market_db.gd"
StoryDb="*res://scripts/autoload/story_db.gd"
CommissionDb="*res://scripts/autoload/commission_db.gd"
FishAntiques="*res://scripts/autoload/fish_antiques_db.gd"
MuseumDb="*res://scripts/autoload/museum_db.gd"
Achievements="*res://scripts/autoload/achievements.gd"
SeasonEvents="*res://scripts/autoload/season_events_db.gd"
WorldMapDb="*res://scripts/autoload/world_map_db.gd"
RanchWeather="*res://scripts/autoload/ranch_weather_db.gd"
FestivalGames="*res://scripts/autoload/festival_games.gd"
ArtPipeline="*res://scripts/autoload/art_pipeline.gd"
Tr="*res://scripts/autoload/tr.gd"
ItemDb="*res://scripts/autoload/item_db.gd"
CropDb="*res://scripts/autoload/crop_db.gd"
RecipeDb="*res://scripts/autoload/recipe_db.gd"
NpcDb="*res://scripts/autoload/npc_db.gd"
MineDb="*res://scripts/autoload/mine_db.gd"
ShopDb="*res://scripts/autoload/shop_db.gd"
Inventory="*res://scripts/autoload/inventory.gd"
TimeSystem="*res://scripts/autoload/time_system.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

